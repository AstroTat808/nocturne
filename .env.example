# Local-only example values. Never commit real secrets.
NOCTURNE_SITE_URL=https://nocturnefestival.com
NOCTURNE_ADMIN_KEY=replace-with-a-long-random-secret
NOCTURNE_ADMIN_SESSION_SECRET=replace-with-a-second-long-random-secret
NOCTURNE_TICKET_ACCESS_SECRET=replace-with-a-dedicated-ticket-access-secret
NOCTURNE_TICKET_ACCESS_TTL_HOURS=168
NOCTURNE_TICKET_REENTRY_TTL_HOURS=168
NOCTURNE_VENUE_NAME=replace-with-private-venue-name
NOCTURNE_VENUE_ADDRESS=replace-with-private-venue-address

# Digital ticket signing and door check-in. Dedicated values are recommended.
NOCTURNE_TICKET_QR_SECRET=replace-with-a-long-random-ticket-qr-secret
NOCTURNE_CHECKIN_KEY=replace-with-a-door-staff-password
NOCTURNE_CHECKIN_SESSION_SECRET=replace-with-a-long-random-checkin-session-secret
NOCTURNE_BAR_KEY=replace-with-a-bar-staff-password
NOCTURNE_BAR_SESSION_SECRET=replace-with-a-long-random-bar-session-secret

# Invitation request anti-spam. The site key is public; the secret must remain private.
NOCTURNE_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key
NOCTURNE_TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret-key

# Resend email delivery.
# NOCTURNE_EMAIL_FROM is reserved for transactional invitation/ticket/payment/access messages.
# NOCTURNE_UPDATES_EMAIL_FROM is reserved for promotional add-on/update campaigns and includes unsubscribe support.
RESEND_API_KEY=re_replace-with-resend-secret
NOCTURNE_EMAIL_FROM=NOCTURNE Tickets <tickets@nocturnefestival.com>
NOCTURNE_UPDATES_EMAIL_FROM=NOCTURNE Updates <updates@nocturnefestival.com>
NOCTURNE_APPLICATION_NOTIFY_TO=invites@nocturnefestival.com
NOCTURNE_HELP_EMAIL=help@nocturnefestival.com
NOCTURNE_OPS_ALERT_TO=invites@nocturnefestival.com

# Daily follow-up for approved guests whose invitation email was sent but whose code is still unredeemed.
# Netlify runs this scheduled function at 19:00 UTC / 9:00 AM Hawai‘i time.
# If these two settings are omitted, the invite-reminder job inherits the purchase-reminder enabled/mode settings below.
NOCTURNE_INVITE_REMINDERS_ENABLED=false
NOCTURNE_INVITE_REMINDERS_MODE=test
NOCTURNE_INVITE_REMINDER_MIN_HOURS=20
NOCTURNE_INVITE_REMINDER_BATCH_LIMIT=100

# Daily follow-up for approved guests who redeemed an invite but have not purchased.
# Netlify runs the scheduled function at 20:00 UTC / 10:00 AM Hawai‘i time.
NOCTURNE_PURCHASE_REMINDERS_ENABLED=false
NOCTURNE_PURCHASE_REMINDERS_MODE=test
NOCTURNE_PURCHASE_REMINDER_MIN_HOURS=20
NOCTURNE_PURCHASE_REMINDER_BATCH_LIMIT=100
NOCTURNE_EVENT_START_ISO=2026-09-06T15:00:00-10:00
NOCTURNE_BACKUP_RETENTION_DAYS=30

# Stripe ticketing. Admission is $25 through Sept. 1, then automatically changes to $35 at midnight HST Sept. 2.
STRIPE_SECRET_KEY=sk_test_replace-with-stripe-secret
STRIPE_WEBHOOK_SECRET=whsec_replace-with-webhook-signing-secret
NOCTURNE_TICKET_PRICE_CENTS=2500
NOCTURNE_TICKET_PRICE_AFTER_CENTS=3500
NOCTURNE_TICKET_PRICE_CHANGE_ISO=2026-09-02T00:00:00-10:00
NOCTURNE_TICKET_CURRENCY=usd
NOCTURNE_TICKET_NAME=NOCTURNE Festival — General Admission
NOCTURNE_TICKET_DESCRIPTION=Private admission for one approved NOCTURNE guest.
NOCTURNE_DRINK_PACKAGE_ENABLED=true
NOCTURNE_DRINK_PACKAGE_PRICE_CENTS=5500
NOCTURNE_DRINK_REDEMPTION_WARNING_MINUTES=45
NOCTURNE_WATER_PACKAGE_ENABLED=true
NOCTURNE_WATER_PACKAGE_PRICE_CENTS=1500
NOCTURNE_LATE_STAY_ENABLED=true
NOCTURNE_LATE_STAY_PRICE_CENTS=2000
NOCTURNE_LATE_STAY_CAPACITY=30

# Apple Wallet event passes. Certificate values may be PEM text or base64-encoded PEM.
NOCTURNE_APPLE_PASS_TYPE_ID=pass.com.nocturnefestival.ticket
NOCTURNE_APPLE_TEAM_ID=replace-with-apple-team-id
NOCTURNE_APPLE_WWDR_CERT_BASE64=replace-with-base64-encoded-wwdr-pem
NOCTURNE_APPLE_PASS_CERT_BASE64=replace-with-base64-encoded-pass-certificate-pem
NOCTURNE_APPLE_PASS_KEY_BASE64=replace-with-base64-encoded-private-key-pem
NOCTURNE_APPLE_PASS_KEY_PASSPHRASE=

# Legacy external ticket provider override. Leave unset when using the built-in Stripe ticketing flow.
# NOCTURNE_TICKET_URL=https://ticket-provider.example/private-checkout