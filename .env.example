# Local-only example values. Never commit real secrets.
NOCTURNE_SITE_URL=https://nocturnefestival.com
NOCTURNE_ADMIN_KEY=replace-with-a-long-random-secret
NOCTURNE_ADMIN_SESSION_SECRET=replace-with-a-second-long-random-secret
NOCTURNE_TICKET_ACCESS_SECRET=replace-with-a-dedicated-ticket-access-secret
NOCTURNE_TICKET_ACCESS_TTL_HOURS=168

# Digital ticket signing and door check-in. Dedicated values are recommended.
NOCTURNE_TICKET_QR_SECRET=replace-with-a-long-random-ticket-qr-secret
NOCTURNE_CHECKIN_KEY=replace-with-a-door-staff-password
NOCTURNE_CHECKIN_SESSION_SECRET=replace-with-a-long-random-checkin-session-secret

# Resend approval / confirmation emails
RESEND_API_KEY=re_replace-with-resend-secret
NOCTURNE_EMAIL_FROM=NOCTURNE <invites@nocturnefestival.com>
NOCTURNE_APPLICATION_NOTIFY_TO=invites@nocturnefestival.com
NOCTURNE_HELP_EMAIL=help@nocturnefestival.com

# Stripe ticketing. Start with Stripe TEST mode keys until the entire flow is verified.
STRIPE_SECRET_KEY=sk_test_replace-with-stripe-secret
STRIPE_WEBHOOK_SECRET=whsec_replace-with-webhook-signing-secret
NOCTURNE_TICKET_PRICE_CENTS=5000
NOCTURNE_TICKET_CURRENCY=usd
NOCTURNE_TICKET_NAME=NOCTURNE Festival — General Admission
NOCTURNE_TICKET_DESCRIPTION=Private admission for one approved NOCTURNE guest.

# Legacy external ticket provider override. Leave unset when using the built-in Stripe ticketing flow.
# NOCTURNE_TICKET_URL=https://ticket-provider.example/private-checkout
